<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<DebugType Condition="'$(Configuration)'=='Debug'">embedded</DebugType>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AssemblyName>Lidarr.Plugin.MusicEnhancer</AssemblyName>
		<AssemblyVersion>1.0.1.2</AssemblyVersion>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<Branch></Branch>
		<Author>waynebowie99</Author>
		<RepoUrl>https://github.com/waynebowie99/lidarr-plugin-musicenhancer</RepoUrl>
		<CI>false</CI>
		<InformationalVersion>$(AssemblyVersion)-$(Branch)</InformationalVersion>
		<DefineConstants Condition="'$(CI)' == true">$(DefineConstants);CI</DefineConstants>
		<DefineConstants Condition="'$(Branch)' == 'master'">$(DefineConstants);MASTER_BRANCH</DefineConstants>
		<DefineConstants Condition="'$(Branch)' == 'develop'">$(DefineConstants);DEV_BRANCH</DefineConstants>
		<DefineConstants Condition="'$(Branch)' != 'master' AND '$(Branch)' != 'develop'">$(DefineConstants);FEATURE_BRANCH</DefineConstants>
		<!-- This project has no analyzer/style configuration of its own -->
		<EnableAnalyzers>false</EnableAnalyzers>
		<EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
		<!-- Disable NuGet audit to avoid vulnerability warnings -->
		<NuGetAudit>false</NuGetAudit>
		<!-- Use Lidarr's custom NuGet feed for TagLibSharp-Lidarr -->
		<NuGetConfigFile>$(MSBuildProjectDirectory)\..\NuGet.config</NuGetConfigFile>
		<!--
			Compile against the verified Lidarr release assemblies fetched by
			scripts/prepare-lidarr.py instead of building the Lidarr source tree.
			Keep this version in sync with prepare-lidarr.py.
		-->
		<LidarrVersion>3.2.1.5196</LidarrVersion>
		<LidarrReferenceDir>$(MSBuildThisFileDirectory)..\..\_temp\lidarr\$(LidarrVersion)\</LidarrReferenceDir>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="FuzzySharp" Version="2.0.2" />
		<PackageReference Include="Sentry" Version="6.9.0" />
		<PackageReference Include="SharpCompress" Version="0.50.4" />
		<PackageReference Include="YamlDotNet" Version="18.1.0" />
	</ItemGroup>

	<ItemGroup>
		<Reference Include="Lidarr.Core">
			<HintPath>$(LidarrReferenceDir)Lidarr.Core.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="Lidarr.Common">
			<HintPath>$(LidarrReferenceDir)Lidarr.Common.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="Lidarr.Http">
			<HintPath>$(LidarrReferenceDir)Lidarr.Http.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="NLog">
			<HintPath>$(LidarrReferenceDir)NLog.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="FluentValidation">
			<HintPath>$(LidarrReferenceDir)FluentValidation.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="Newtonsoft.Json">
			<HintPath>$(LidarrReferenceDir)Newtonsoft.Json.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="System.IO.Abstractions">
			<HintPath>$(LidarrReferenceDir)System.IO.Abstractions.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="TagLibSharp">
			<HintPath>$(LidarrReferenceDir)TagLibSharp.dll</HintPath>
			<Private>false</Private>
		</Reference>
	</ItemGroup>

	<Target Name="EnsureLidarrReferences" BeforeTargets="ResolveAssemblyReferences">
		<Error Condition="!Exists('$(LidarrReferenceDir)Lidarr.Core.dll')"
		       Text="Lidarr reference assemblies were not found in '$(LidarrReferenceDir)'. Run 'python scripts/prepare-lidarr.py' before building." />
	</Target>

	<ItemGroup>
		<PackageReference Update="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<!-- Package release target - creates ZIP file for plugin installation -->
	<Target Name="PackageRelease" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
		<PropertyGroup>
			<ReleasePackageDir>$(IntermediateOutputPath)package/</ReleasePackageDir>
		</PropertyGroup>
		<RemoveDir Directories="$(ReleasePackageDir)" />
		<MakeDir Directories="$(ReleasePackageDir)" />
		<Copy SourceFiles="$(TargetPath);$(TargetDir)$(TargetName).pdb" DestinationFolder="$(ReleasePackageDir)" />
		<ZipDirectory SourceDirectory="$(ReleasePackageDir)" DestinationFile="$(TargetDir)$(TargetName).net8.0.zip" Overwrite="true" />
	</Target>

</Project>
