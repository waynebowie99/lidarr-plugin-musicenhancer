<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<DebugType Condition="'$(Configuration)'=='Debug'">embedded</DebugType>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AssemblyName>Lidarr.Plugin.MusicEnhancer</AssemblyName>
		<AssemblyVersion>1.0.2.1</AssemblyVersion>
		<Author>waynebowie99</Author>
		<RepoUrl>https://github.com/waynebowie99/lidarr-plugin-musicenhancer</RepoUrl>
		<InformationalVersion>$(AssemblyVersion)</InformationalVersion>
		<!--
			Compile against the verified Lidarr release assemblies fetched by
			scripts/prepare-lidarr.py instead of building the Lidarr source tree.
			Keep this version in sync with prepare-lidarr.py.
		-->
		<LidarrVersion>3.1.6.5079</LidarrVersion>
		<LidarrReferenceDir>$(MSBuildThisFileDirectory)..\..\_temp\lidarr\$(LidarrVersion)\</LidarrReferenceDir>
	</PropertyGroup>

	<ItemGroup>
		<Reference Include="Lidarr.Core">
			<HintPath>$(LidarrReferenceDir)Lidarr.Core.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="Lidarr.Common">
			<HintPath>$(LidarrReferenceDir)Lidarr.Common.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="NLog">
			<HintPath>$(LidarrReferenceDir)NLog.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="FluentValidation">
			<HintPath>$(LidarrReferenceDir)FluentValidation.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="TagLibSharp">
			<HintPath>$(LidarrReferenceDir)TagLibSharp.dll</HintPath>
			<Private>false</Private>
		</Reference>
	</ItemGroup>

	<Target Name="EnsureLidarrReferences" BeforeTargets="ResolveAssemblyReferences">
		<Error Condition="!Exists('$(LidarrReferenceDir)Lidarr.Core.dll')"
		       Text="Lidarr reference assemblies were not found in '$(LidarrReferenceDir)'. Run 'python scripts/prepare-lidarr.py' before building." />
	</Target>

	<!-- Package release target - creates ZIP file for plugin installation -->
	<Target Name="PackageRelease" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
		<PropertyGroup>
			<ReleasePackageDir>$(IntermediateOutputPath)package/</ReleasePackageDir>
		</PropertyGroup>
		<RemoveDir Directories="$(ReleasePackageDir)" />
		<MakeDir Directories="$(ReleasePackageDir)" />
		<Copy SourceFiles="$(TargetPath);$(TargetDir)$(TargetName).pdb" DestinationFolder="$(ReleasePackageDir)" />
		<ZipDirectory SourceDirectory="$(ReleasePackageDir)" DestinationFile="$(TargetDir)$(TargetName).net8.0.zip" Overwrite="true" />
	</Target>

</Project>
